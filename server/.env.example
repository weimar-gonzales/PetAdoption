NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_adoption
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
MANAGEMENT_API_KEY=
SESSION_SECRET=
SESSION_MAX_AGE_MS=604800000
SESSION_COOKIE_NAME=pet_adoption_session
SECURE_COOKIES=false
# Maximum uploaded pet image size in bytes (5 MiB by default)
PET_IMAGE_MAX_BYTES=5242880
# Relative paths resolve from the server directory; absolute paths are allowed.
PET_IMAGE_DIRECTORY=uploads/pets
